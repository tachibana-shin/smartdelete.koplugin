{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's/version = \".*\"/version = \"${nextRelease.version}\"/' _meta.lua"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "mkdir -p dist/smartdelete.koplugin && cp _meta.lua i18n.lua main.lua dist/smartdelete.koplugin/ && cd dist && zip -r ../smartdelete.koplugin-${nextRelease.version}.zip smartdelete.koplugin && rm -rf smartdelete.koplugin"
    }],
    ["@semantic-release/git", {
      "assets": ["_meta.lua", "CHANGELOG.md", "package.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": ["smartdelete.koplugin-*.zip"]
    }]
  ]
}
